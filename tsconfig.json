{
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "./src",
		"noImplicitAny": false,
		"declaration": true,

		"module": "commonjs",
		"target": "es2016",

		"sourceMap": true,
		"esModuleInterop": true,

		"strict": true,
		"lib": [
			"es2018"
		],
		"types": ["node", "jest"]
	},
	"include": [
		"./src/**/*"
	]
}